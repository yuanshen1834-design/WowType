+    TF_SELECTION selection{};
+    selection.range = range;
+    selection.style.ase = TF_AE_END;
+    selection.style.fInterimChar = FALSE;
+    textEditSinkContext_->SetSelection(ec, 1, &selection);
     return S_OK;
 }
